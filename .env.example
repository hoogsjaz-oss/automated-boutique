# ─────────────────────────────────────────────────────────────────────────
# Automated Boutique — environment variables
# Copy to your n8n instance as Environment Variables (Settings → Variables, or
# the host's env). n8n reads these via {{ $env.NAME }} inside the workflows.
# Never commit real secrets — keep this file as the template only.
# ─────────────────────────────────────────────────────────────────────────

# --- General ---
BOUTIQUE_NAME=Your Boutique Name
OWNER_EMAIL=hoogsjaz@gmail.com

# --- Google Sheet (the catalog / orders source of truth) ---
# The long ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GSHEET_ID=

# --- Claude (Anthropic) for the customer reply bot ---
ANTHROPIC_API_KEY=
# Reply model. claude-sonnet-4-6 is the recommended default (fast + cheap enough
# for chat). Use claude-opus-4-8 if you want maximum quality.
CLAUDE_MODEL=claude-sonnet-4-6

# --- WhatsApp Business (Cloud API, via Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A token YOU invent; paste the same value into Meta's webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=

# --- Meta (Facebook Page + Instagram share one Graph token) ---
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=

# --- Payments ---
# Choose how customers pay: mpesa | airtel | bank
PAYMENT_METHOD=mpesa
# Default currency when a product row doesn't specify one.
DEFAULT_CURRENCY=KES

# M-Pesa (Safaricom Daraja) — used when PAYMENT_METHOD=mpesa (STK Push)
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                  # your Paybill or Till (BusinessShortCode)
MPESA_PASSKEY=                    # Lipa na M-Pesa Online passkey
MPESA_TX_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_CALLBACK_URL=               # public https URL Daraja posts the result to

# Airtel Money — used when PAYMENT_METHOD=airtel (Collection API)
AIRTEL_ENV=sandbox                # sandbox | production
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE                 # ISO country code, e.g. KE, TZ, UG
AIRTEL_CURRENCY=KES
AIRTEL_COUNTRY_CODE=254           # dialing code, used to strip the phone prefix

# Bank transfer — used when PAYMENT_METHOD=bank (manual). This whole block is
# sent to the customer verbatim, so write it how you want it to appear:
BANK_DETAILS=Bank: Equity Bank | Account name: Your Boutique | Account no: 0123456789 | Branch: Nairobi
