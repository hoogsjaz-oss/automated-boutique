{
  "name": "Boutique \u2014 1. Weekly Scheduler & Poster",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "c9e6d42a-4133-4961-9ada-b114fbec5d14",
      "name": "Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -660,
        300
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GSHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Products",
          "mode": "name"
        },
        "options": {}
      },
      "id": "60d48eb2-4179-4539-96ee-9ad265f0b323",
      "name": "Read Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reads all Products rows and keeps the ones scheduled to post today.\n// A product posts when: Active == TRUE and PostDay == today's weekday name.\n// Builds a ready-to-use caption for each kept product.\nconst weekday = new Intl.DateTimeFormat('en-US', { weekday: 'long' })\n  .format(new Date());                                  // e.g. \"Monday\"\nconst boutique = $env.BOUTIQUE_NAME || 'Our Boutique';\n\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  const active = String(p.Active).toUpperCase() === 'TRUE';\n  if (!active) continue;\n  if (String(p.PostDay).trim().toLowerCase() !== weekday.toLowerCase()) continue;\n\n  const stock = Number(p.Stock) || 0;\n  const price = `${p.Currency || 'R'}${p.Price}`;\n  const sizes = String(p.Sizes || '').split(',').map(s => s.trim()).filter(Boolean);\n  const colours = String(p.Colours || '').split(',').map(s => s.trim()).filter(Boolean);\n\n  const caption =\n    `\u2728 ${p.Name} \u2728\\n\\n` +\n    `${p.Description || ''}\\n\\n` +\n    `\ud83d\udcb0 Price: ${price}\\n` +\n    (sizes.length ? `\ud83d\udccf Sizes: ${sizes.join(', ')}\\n` : '') +\n    (colours.length ? `\ud83c\udfa8 Colours: ${colours.join(', ')}\\n` : '') +\n    (stock > 0 ? `\u2705 In stock` : `\u23f3 Restocking soon`) + `\\n\\n` +\n    `\ud83d\udcac WhatsApp us to order! \u2014 ${boutique}`;\n\n  out.push({\n    json: {\n      sku: p.SKU,\n      name: p.Name,\n      price,\n      sizes,\n      colours,\n      stock,\n      imageUrl: p.ImageURL,\n      caption,\n      postDay: p.PostDay,\n    },\n  });\n}\n\nif (out.length === 0) {\n  // Nothing scheduled today \u2014 stop the branch cleanly.\n  return [];\n}\nreturn out;"
      },
      "id": "ef48734d-144f-40be-96f7-af822d61a51b",
      "name": "Filter & Build Captions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.FB_PAGE_ID }}/photos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.imageUrl, caption: $json.caption }) }}"
      },
      "id": "726fdcbc-1aa1-429d-b5d9-69c61d7fb7d3",
      "name": "Facebook Page Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.IG_USER_ID }}/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
