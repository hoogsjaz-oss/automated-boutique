      "id": "239526e3-9af4-4f60-bd32-7ba16ec723e7",
      "name": "Read Subscribers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        40,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cross-joins today's products with opted-in subscribers so each subscriber\n// receives each scheduled product as a WhatsApp image message.\n// WhatsApp policy: only message users who have opted in. For marketing\n// outside the 24h window you should use an approved message template.\nconst products = $items('Filter & Build Captions').map(i => i.json);\nconst subs = $items('Read Subscribers')\n  .map(i => i.json)\n  .filter(s => String(s.OptInStatus).toUpperCase() === 'OPTED_IN');\n\nconst out = [];\nfor (const s of subs) {\n  for (const p of products) {\n    out.push({\n      json: {\n        to: String(s.Phone).replace(/[^0-9]/g, ''),\n        name: s.Name,\n        imageUrl: p.imageUrl,\n        caption: p.caption,\n        sku: p.sku,\n      },\n    });\n  }\n}\nreturn out;"
      },
      "id": "9b04b24e-9d96-4bd9-a593-21335fd49922",
      "name": "Build WhatsApp Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        640
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.to, type: 'image', image: { link: $json.imageUrl, caption: $json.caption } }) }}"
      },
      "id": "d39232eb-d15c-4a11-bb25-ce95de11a1be",
      "name": "WhatsApp Send Broadcast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        640
      ]
    }
  ],
