        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $json.imageUrl, caption: $json.caption }) }}"
      },
      "id": "f5a4b093-a034-4ccb-83a8-e6c7664b27e6",
      "name": "Instagram Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Instagram publishing is two calls: create a media container, then publish it.\n// This node just passes the creation_id from the previous (container) node\n// through together with the IG user id so the Publish node can use it.\nreturn $input.all().map(i => ({\n  json: { creation_id: i.json.id }\n}));"
      },
      "id": "af1de3d8-8cb4-40e6-8975-1c462b09359d",
      "name": "Pass creation_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.IG_USER_ID }}/media_publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creation_id: $json.creation_id }) }}"
      },
      "id": "e6077d76-bf06-420b-9db4-49b60e2eecc7",
      "name": "Instagram Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/content/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=UTF-8"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: $json.name, description: $json.caption, disable_comment: false, privacy_level: 'PUBLIC_TO_EVERYONE' }, source_info: { source: 'PULL_FROM_URL', photo_cover_index: 0, photo_images: [$json.imageUrl] }, post_mode: 'DIRECT_POST', media_type: 'PHOTO' }) }}"
      },
      "id": "3f2d8156-81a0-4f18-9f0f-d29ae560aac1",
      "name": "TikTok Init Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        440
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GSHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Subscribers",
          "mode": "name"
        },
        "options": {}
