    {
      "parameters": {
        "jsCode": "// Given a new order, find the matching product row and compute the new stock.\n// Outputs the row number + new stock so the next node can update the sheet.\nconst order = $items('New Order Trigger')[0].json;\nconst products = $items('Read Products for Stock');\n\nlet match = null;\nlet rowNumber = null;\nproducts.forEach((it, i) => {\n  if (String(it.json.SKU).trim() === String(order.SKU).trim()) {\n    match = it.json;\n    // Google Sheets node exposes the spreadsheet row via row_number when read.\n    rowNumber = it.json.row_number || (i + 2); // +2: header row + 1-based\n  }\n});\n\nif (!match) {\n  return [{ json: { ok: false, reason: 'SKU not found', sku: order.SKU, order } }];\n}\n\nconst qty = Number(order.Qty) || 1;\nconst current = Number(match.Stock) || 0;\nconst newStock = Math.max(0, current - qty);\n\nreturn [{\n  json: {\n    ok: true,\n    sku: order.SKU,\n    rowNumber,\n    newStock,\n    lowStock: newStock <= 2,\n    order,\n    productName: match.Name,\n  },\n}];"
      },
      "id": "61b75c75-6b90-45c0-b868-9c1c0c111cce",
      "name": "Compute New Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ok1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "36cd3498-c52a-4e2d-a20c-65c09d5bdb6f",
